{
  "name": "voto-programa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "tsx server/node.ts",
    "dev:api": "wrangler dev",
    "db:migrar": "wrangler d1 migrations apply voto-programa --remote",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "interno:posicoes": "wrangler d1 execute voto-programa --remote --command \"SELECT eleicao, posicao, votos FROM posicao_voto ORDER BY eleicao, posicao\"",
    "interno:candidatos": "wrangler d1 execute voto-programa --remote --command \"SELECT eleicao, candidato, votos FROM placar ORDER BY eleicao, votos DESC\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.9",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  }
}
